# Pine Lake Recreation — environment configuration
#
# Copy this file to `.env` and fill in your Supabase project credentials.
# When BOTH values are present the app connects to live Supabase; if either is
# missing it automatically falls back to the in-browser LocalStorage mock so the
# app still runs end-to-end with zero backend.
#
# Find these under: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
